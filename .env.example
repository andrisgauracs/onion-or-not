# Copy this file to .env and fill in your own values. Never commit .env.

# Your TypeSafe API key (https://typesafe.ai). Needed for Jev; leave empty to use AnyJev only.
TYPESAFE_API_KEY=

# Which Jev version to ask.
JEV_MODEL=jev-1.13.0

# Which downloaded Qwen3-8B GGUF to load: Q4_K_M (default), Q5_K_M, Q6_K or Q8_0.
ONION_QUANT=Q4_K_M

# Or point at a Qwen3-8B GGUF you already have (overrides ONION_QUANT).
# ONION_GGUF=/path/to/Qwen3-8B-Q8_0.gguf

# Model layers on the GPU: -1 = all, 0 = CPU only.
ONION_GPU_LAYERS=-1

# Where the site listens. Keep 127.0.0.1 unless you know why not.
HOST=127.0.0.1
PORT=8000
